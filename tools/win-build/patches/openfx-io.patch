+#ifdef OFX_IO_USING_OCIO
+// OpenImageIO 3.x labels files with the canonical names of OCIO's built-in config
+// ("srgb_rec709_scene", "lin_rec709", "g22_rec709", ...) and their aliases, where
+// OIIO 2.x wrote the legacy hints "sRGB" / "Linear" / "GammaCorrected". The per-config
+// lookup in guessColorspace() understands only the legacy hints, so fold the new
+// names back onto them. Names not in the table pass through unchanged (they may
+// still exist in the active config). *gamma receives the encoding gamma for the
+// "GammaCorrected" hint, 0 otherwise.
+static const char*
+legacyColorSpaceHint(const char* name,
+                     float* gamma)
+{
+    struct Hint { const char* oiio; const char* legacy; float gamma; };
+    static const Hint table[] = {
+        // sRGB-encoded textures
+        { "srgb_rec709_scene", "sRGB", 0.f },
+        { "srgb_tx", "sRGB", 0.f },
+        { "srgb_texture", "sRGB", 0.f },
+        { "sRGB - Texture", "sRGB", 0.f },
+        { "Utility - sRGB - Texture", "sRGB", 0.f },
+        { "sRGB Encoded Rec.709 (sRGB)", "sRGB", 0.f },
+        { "srgb_p3d65", "sRGB", 0.f }, // closest a classic config can do
+        // pure-gamma encodings
+        { "g22_rec709", "GammaCorrected", 2.2f },
+        { "g18_rec709", "GammaCorrected", 1.8f },
+        // scene-linear (a classic config has one linear space; primaries are lost)
+        { "lin_rec709", "Linear", 0.f },
+        { "lin_srgb", "Linear", 0.f },
+        { "linear", "Linear", 0.f },
+        { "scene_linear", "Linear", 0.f },
+        { "Linear Rec.709 (sRGB)", "Linear", 0.f },
+        { "Utility - Linear - sRGB", "Linear", 0.f },
+        { "lin_ap0", "Linear", 0.f },
+        { "lin_ap1", "Linear", 0.f },
+        { "lin_p3d65", "Linear", 0.f },
+        { "lin_rec2020", "Linear", 0.f },
+    };
+    *gamma = 0.f;
+    for (std::size_t i = 0; i < sizeof(table) / sizeof(table[0]); ++i) {
+        if (!strcmp(name, table[i].oiio)) {
+            *gamma = table[i].gamma;
+
+            return table[i].legacy;
+        }
+    }
+
+    return name;
+}
+#endif // OFX_IO_USING_OCIO
