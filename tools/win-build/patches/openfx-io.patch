 } // colorSpaceName
 
+// The colorspace to fall back on when a name is not in the config. The stock
+// code used the "default" ROLE and, when that was missing, wrote the literal
+// string "default" into the knob - which is exactly what the ACES 1.x/2.x
+// cg/studio configs lack, so every reset under those configs produced a text
+// field reading "default" and "Color space 'default' could not be found".
+// Try the roles a config is likely to have, then the first active colorspace.
+static string
+fallbackColorSpaceName(OCIO::ConstConfigRcPtr config)
+{
+    if (!config) {
+        return string();
+    }
+    const char* roles[] = { OCIO::ROLE_DEFAULT, OCIO::ROLE_SCENE_LINEAR, OCIO::ROLE_REFERENCE };
+    for (size_t i = 0; i < sizeof(roles) / sizeof(roles[0]); ++i) {
+        OCIO::ConstColorSpaceRcPtr cs = config->getColorSpace(roles[i]);
+        if (cs) {
+            return cs->getName();
+        }
+    }
+    if (config->getNumColorSpaces() > 0) {
+        const char* first = config->getColorSpaceNameByIndex(0);
+        if (first && *first) {
+            return first;
+        }
+    }
+    return string();
+}
